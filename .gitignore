# No trailing slash: with one, this matches only a directory, and a worktree that reaches its
# dependencies through a `node_modules` symlink commits the symlink instead of ignoring it.
node_modules
.corpus/
.solereview/
dist/
coverage/
app/public/shoes.json
app/src/assets/fonts/
playwright-report/
test-results/
.notes/
.superpowers/
# The bug hunt's scratch rig and finding queue. Must be ignored before the first finding is
# written: check:docs scans untracked-but-unignored files for dead doc pointers, so a finding
# that correctly reports a broken pointer would fail the build by being right.
.hunt/
